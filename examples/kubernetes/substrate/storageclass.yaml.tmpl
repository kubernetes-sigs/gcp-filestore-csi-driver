# Sample StorageClass for GKE Substrate integration with GCP Filestore VolumePools.
#
# VolumePools (FiFA Fast Availability) provide sub-second dynamic volume claims from
# pre-warmed Filestore multi-share instances.
#
# Usage (Automated):
#   Use the deployment script to dynamically render and apply this template:
#   deploy.sh --project-id <PROJECT_ID> --volumepool-location <LOCATION> --volumepool-name <VOLUMEPOOL_NAME>
#
# Usage (Manual):
#   1. Copy this template to a new file (e.g., storageclass.yaml).
#   2. Replace <PROJECT_ID>, <LOCATION>, <VOLUMEPOOL_NAME>, and <STORAGECLASS_NAME>.
#   3. Apply: kubectl apply -f storageclass.yaml
#
# Mount options note:
#   Agent Substrate reads only StorageClass.provisioner and StorageClass.parameters
#   and ignores StorageClass.mountOptions, so NFS client options must be set under
#   parameters.mount-options.
#   - The value is ONE comma-separated string with no spaces. Never fold it with a
#     YAML ">" or "|" block scalar, which would add spaces or newlines.
#   - Any value replaces all of the CSI driver's default mount options, so list
#     every option you want.
#   - These options are tuned for dedicated single-actor workspaces, where only one
#     node mounts a volume at a time: nolock keeps file locks local to the node and
#     actimeo=60 caches file and directory attributes for 60 seconds. Don't reuse this
#     StorageClass for volumes that several nodes mount at the same time (shared
#     ReadWriteMany volumes); create a separate StorageClass without nolock and
#     actimeo=60 for those.
#   - StorageClass parameters can't be changed after creation. To change them,
#     delete the StorageClass and create it again. Existing volumes keep the
#     mount-options value they were created with.

apiVersion: storage.k8s.io/v1
kind: StorageClass
metadata:
  name: <STORAGECLASS_NAME>
provisioner: filestore.csi.storage.gke.io
parameters:
  volume-pool: "projects/<PROJECT_ID>/locations/<LOCATION>/volumePools/<VOLUMEPOOL_NAME>"
  mount-options: "vers=3,proto=tcp,mountproto=tcp,port=2049,mountport=2050,nolock,nconnect=8,rsize=524288,wsize=524288,actimeo=60"
allowVolumeExpansion: false
reclaimPolicy: Delete
volumeBindingMode: Immediate
